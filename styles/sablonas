body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    line-height: 1.6;
    color: #333;
    margin: 0;
    padding: 0;
    background-color: #f9f9f9;
}

.content-wrapper {
    max-width: 800px;
    margin: 20px auto;
    background: #fff;
    padding: 40px;
    box-shadow: 0 0 10px rgba(0,0,0,0.05);
}

.site-header {
    text-align: center;
    padding: 20px;
    border-bottom: 1px solid #eee;
}

.post-header h1 {
    font-size: 2.5rem;
    margin-bottom: 10px;
}

.hero-image {
    width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 20px 0;
}


.recipe-card {
    border: 2px solid #e2e2e2;
    border-radius: 12px;
    margin-top: 50px;
    padding: 30px;
    background-color: #fff;
}

.recipe-card-header {
    text-align: center;
    border-bottom: 1px solid #eee;
    margin-bottom: 20px;
    padding-bottom: 10px;
}

.recipe-meta {
    display: flex;
    justify-content: space-around;
    background: #f3f3f3;
    padding: 15px;
    border-radius: 8px;
    margin-bottom: 30px;
}

.recipe-body {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 30px;
    color:red;
}

h3 {
    border-bottom: 2px solid #d4a373;
    display: inline-block;
    margin-bottom: 15px;
}

.ingredients ul, .instructions ol {
    padding-left: 20px;
    color:red;
}

.nutrition {
    margin-top: 30px;
    font-size: 0.9rem;
    color: #666;
    border-top: 1px solid #eee;
    padding-top: 15px;
    color:red;
}

@media (max-width: 600px) {
    .recipe-body {
        grid-template-columns: 1fr;
    }
    .content-wrapper {
        padding: 15px;
    }
}
